---
import IconLinks from '../../../../components/IconLinks.astro';
import SocialPreview from '../../../../components/SocialPreview.astro';
import UmamiAnalytics from '../../../../components/UmamiAnalytics.astro';
import ComicReader from '../../../../components/ComicReader.astro';
import manga from '../../../../data/sleep_manga.json';

const storyPath = '/writing/to-sleep-perchance-to-dream/';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" />
		<title>{manga.title} — Manga | Noah Eisen</title>
		<IconLinks />
		<SocialPreview
			title={`${manga.title} — Manga`}
			description="Read the manga adaptation of Noah Eisen's short story, To Sleep, Perchance to Dream."
			path={`${storyPath}manga/`}
			image={manga.pages[0].smallImage}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400&display=swap" rel="stylesheet" />
		<UmamiAnalytics />
	</head>
	<body>
		<a class="skip-link" href="#reader">Skip to manga</a>
		<header class="manga-header">
			<nav aria-label="Manga navigation">
				<a href={storyPath}>← Read the short story</a>
			</nav>
			<div class="title-row">
				<h1>{manga.title}</h1>
			</div>
		</header>
		<main id="reader">
			<ComicReader title={manga.title} pages={manga.pages} storageKey={`sleep-manga-${manga.sourceSha256.slice(0, 12)}`} />
			<footer class="manga-footer">
				<a href="/writing/">All writing</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
	:global(html) { --accent: #9b86d8; background: #0a0a0a; color-scheme: dark; }
	:global(body) { margin: 0; background: radial-gradient(circle at 50% -18%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 34rem), #0a0a0a; color: #d5d1c8; font-family: 'DM Sans', sans-serif; -webkit-font-smoothing: antialiased; }
	a { color: #666; text-decoration: none; transition: color 0.15s; }
	a:hover, a:focus-visible { color: #aaa; }
	a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
	.skip-link { position: absolute; left: 16px; top: -100px; padding: 12px; z-index: 10; background: #1d1d1d; }
	.skip-link:focus { top: 12px; }
	.manga-header { width: min(100% - 48px, 720px); margin: 0 auto; padding: 32px 0 0; }
	nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	nav a, .manga-footer a { display: inline-flex; align-items: center; min-height: 44px; font-size: 10px; font-weight: 500; letter-spacing: 1.2px; text-transform: uppercase; }
	.title-row { padding: 24px 0 28px; text-align: center; }
	h1 { color: #eeeae2; font: 400 clamp(28px, 4vw, 38px)/1.12 'Newsreader', Georgia, serif; letter-spacing: -0.6px; text-wrap: balance; margin: 0; }
	main { max-width: 1048px; margin: 0 auto; padding: 0 24px; }
	.manga-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 24px; max-width: 800px; padding: 24px 16px 48px; margin: 24px auto 0; border-top: 1px solid #1d1d1d; text-align: center; }
	.manga-footer a { color: #555; }
	.manga-footer a:hover, .manga-footer a:focus-visible { color: var(--accent); }
	@media (max-width: 600px) {
		.manga-header { width: min(100% - 40px, 720px); padding: 16px 0 0; }
		.title-row { padding: 24px 8px; }
		main { padding: 0; }
		nav { gap: 14px; }
	}
</style>
