---
import UmamiAnalytics from '../../components/UmamiAnalytics.astro';
import IconLinks from '../../components/IconLinks.astro';
import SocialPreview from '../../components/SocialPreview.astro';
import stories from '../../data/writing_stories.json';

export function getStaticPaths() {
	return stories.map((story) => ({
		params: { slug: story.slug },
		props: { story },
	}));
}

type Story = (typeof stories)[number];

interface Props {
	story: Story;
}

const { story } = Astro.props;
---

<html lang="en" style={`--accent: ${story.accent}`}>
	<head>
		<meta charset="utf-8" />
		<IconLinks />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{story.title} | Noah Eisen</title>
		<SocialPreview
			title={`${story.title} - Noah Eisen`}
			description={story.description}
			path={`/writing/${story.slug}/`}
		/>
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
		<UmamiAnalytics />
		<style>
			*, *::before, *::after { box-sizing: border-box; }
			html { background: #0a0a0a; scroll-behavior: smooth; }

			body {
				margin: 0;
				background:
					radial-gradient(circle at 50% -18%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 34rem),
					#0a0a0a;
				color: #d5d1c8;
				-webkit-font-smoothing: antialiased;
			}

			.reading-progress {
				position: fixed;
				z-index: 10;
				left: 0;
				top: 0;
				width: 100%;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left;
			}

			.shell {
				width: min(100% - 48px, 720px);
				margin: 0 auto;
				padding: 48px 0 96px;
			}

			.story-nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 24px;
				font-family: 'DM Sans', sans-serif;
			}

			.story-nav a {
				color: #666;
				font-size: 10px;
				font-weight: 500;
				letter-spacing: 1.2px;
				text-decoration: none;
				text-transform: uppercase;
				transition: color 0.15s;
			}

			.story-nav a:hover,
			.story-nav a:focus-visible { color: #aaa; }

			.story-header {
				padding: 78px 0 58px;
				border-bottom: 1px solid #1d1d1d;
				text-align: center;
			}

			.story-kicker {
				font-family: 'DM Sans', sans-serif;
				font-size: 10px;
				font-weight: 500;
				letter-spacing: 2.6px;
				text-transform: uppercase;
				color: var(--accent);
			}

			.story-title {
				font-family: 'Newsreader', Georgia, serif;
				font-size: clamp(46px, 8vw, 72px);
				font-weight: 400;
				letter-spacing: -2px;
				line-height: 1.04;
				color: #eeeae2;
				margin: 24px auto 20px;
				max-width: 680px;
				text-wrap: balance;
			}

			.story-byline {
				font-family: 'DM Sans', sans-serif;
				font-size: 11px;
				letter-spacing: 1.3px;
				text-transform: uppercase;
				color: #555;
			}

			.story-body {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 21px;
				line-height: 1.7;
				padding: 66px 0 28px;
			}

			.story-body p {
				margin: 0;
				text-wrap: pretty;
			}

			.story-body p + p { margin-top: 1.45em; }

			.story-body :global(em) {
				font-style: italic;
				color: #e1ddd4;
			}

			.story-body :global(.section-break) {
				display: block;
				margin: 3.8em 0;
				color: #555;
				font-family: 'DM Sans', sans-serif;
				font-size: 11px;
				letter-spacing: 0.7em;
				text-align: center;
			}

			.story-end {
				width: 34px;
				height: 2px;
				background: var(--accent);
				margin: 56px auto 72px;
				opacity: 0.72;
			}

			.story-return {
				padding-top: 32px;
				border-top: 1px solid #1d1d1d;
				font-family: 'DM Sans', sans-serif;
				text-align: center;
			}

			.story-return a {
				color: #555;
				text-decoration: none;
				font-size: 10px;
				font-weight: 500;
				letter-spacing: 1.2px;
				text-transform: uppercase;
				transition: color 0.15s;
			}

			.story-return a:hover,
			.story-return a:focus-visible { color: var(--accent); }

			@media (max-width: 600px) {
				.shell { width: min(100% - 48px, 720px); padding: 32px 0 64px; }
				.story-header { padding: 58px 0 44px; }
				.story-title { font-size: 46px; letter-spacing: -1.2px; }
				.story-body { font-size: 19px; line-height: 1.65; padding-top: 48px; }
			}
		</style>
	</head>
	<body>
		<div class="reading-progress" data-reading-progress aria-hidden="true"></div>
		<main class="shell">
			<nav class="story-nav" aria-label="Story navigation">
				<a href="/writing/">&larr; All writing</a>
				{story.pdfPath && (
					<a
						href={story.pdfPath}
						target="_blank"
						rel="noopener noreferrer"
						data-umami-event="link_click"
						data-umami-event-area="writing"
						data-umami-event-label={`${story.slug}-pdf`}
					>PDF &nearr;</a>
				)}
			</nav>

			<header class="story-header">
				<div class="story-kicker">Short story &nbsp;/&nbsp; {story.year} &nbsp;/&nbsp; {story.readTime}</div>
				<h1 class="story-title">{story.title}</h1>
				<div class="story-byline">By Noah Eisen</div>
			</header>

			<article class="story-body">
				{story.paragraphs.map((paragraph) => <p set:html={paragraph}></p>)}
			</article>

			<div class="story-end" aria-hidden="true"></div>

			<nav class="story-return" aria-label="Back to writing">
				<a href="/writing/">&larr; Back to writing</a>
			</nav>
		</main>

		<script>
			const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
			const updateProgress = () => {
				if (!progress) return;
				const scrollable = document.documentElement.scrollHeight - window.innerHeight;
				const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
				progress.style.transform = `scaleX(${ratio})`;
			};
			updateProgress();
			window.addEventListener('scroll', updateProgress, { passive: true });
		</script>
	</body>
</html>
