---
import UmamiAnalytics from '../../components/UmamiAnalytics.astro';
import IconLinks from '../../components/IconLinks.astro';
import SocialPreview from '../../components/SocialPreview.astro';
import GamePreview from '../../components/arcade/GamePreview.astro';
import Leaderboards from '../../components/arcade/Leaderboards.astro';
import '../../games/arcade/cabinet.css';
import { games, ARCADE_PATH } from '../../games/arcade/catalog';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<IconLinks />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0a0a0a" />
		<title>Sarah Arcade | Noah Eisen</title>
		<SocialPreview title="Sarah Arcade" description="Six little games starring Sarah. Jump, fly, ski, hop, stack, and roll." path={ARCADE_PATH} />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />
		<UmamiAnalytics />
	</head>
	<body>
		<main>
			<header>
				<a class="back-link" href="/projects">← Back to Projects</a>
				<h1>Sarah Arcade</h1>
				<div class="arcade-toolbar"><button class="scores-toggle" type="button" data-flip-scores aria-pressed="false" aria-controls="arcade-cabinets"><span aria-hidden="true">↻</span> <span data-flip-label>High scores</span></button></div>
			</header>
			<div class="games" id="arcade-cabinets" data-cabinets>
				{games.map(game => (
					<article class="game-card" data-cabinet={game.id}><div class="card-rotor">
					<a class="card-front" href={game.path} aria-label={`Play ${game.title}`}>
						<div class="preview"><GamePreview gameId={game.id} /></div>
						<div class="card-body">
							<h2>{game.title}</h2>
							<p>{game.description}</p>
							<div class="card-footer"><span>Best <strong data-best-for={game.id}>0</strong></span><span class="play">Play →</span></div>
						</div>
					</a>
					<section class="card-back" data-card-back inert aria-hidden="true" aria-label={`${game.title} high scores`}>
						<p class="cabinet-kicker">All-time / Top 5</p>
						<h2>{game.title}</h2>
						<div class="cabinet-rule" aria-hidden="true"><span>Rank / Name</span><span>Score</span></div>
						<p class="cabinet-status" data-card-status role="status">Loading scores…</p>
						<ol class="cabinet-scores" data-card-scores aria-label={`${game.title} rankings`}></ol>
						<div class="cabinet-actions"><button type="button" data-open-board={game.id}>Full rankings ↗</button><a href={game.path}>Play →</a></div>
					</section>
					</div></article>
				))}
			</div>
		</main>
		<Leaderboards />
		<script>
			import { initCabinets } from '../../games/arcade/cabinets';
			import { games } from '../../games/arcade/catalog';
			import { readBest } from '../../games/arcade/storage';
			initCabinets();
			function updateBests() {
				for (const game of games) {
					const label = document.querySelector(`[data-best-for="${game.id}"]`);
					if (label) label.textContent = String(readBest(game.bestKey));
				}
			}
			updateBests();
			window.addEventListener('pageshow', updateBests);
			window.addEventListener('storage', updateBests);
		</script>
	</body>
</html>
<style>
	*, *::before, *::after { box-sizing: border-box; }
	:global(html) { background: #0a0a0a; }
	body { margin: 0; color: #e2dfd8; font-family: 'DM Sans', sans-serif; -webkit-font-smoothing: antialiased; }
	main { max-width: 860px; margin: 0 auto; padding: 32px 44px 48px; }
	header { padding-bottom: 24px; border-bottom: 1px solid #1e1e1e; margin-bottom: 28px; }
	.back-link { display: flex; align-items: center; min-height: 32px; width: fit-content; color: #777; text-decoration: none; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
	.back-link:hover { color: #aaa; }
	h1 { font-size: 48px; line-height: 1; letter-spacing: -1.5px; font-weight: 700; text-transform: uppercase; margin: 12px 0 0; color: #eae7e0; }
	.games { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
	.game-card { min-width: 0; perspective: 1200px; }
	.card-front { display: block; color: inherit; text-decoration: none; border: 1px solid #222; border-radius: 6px; overflow: hidden; background: #101010; }
	.card-front:hover { border-color: #555; }
	a:focus-visible { outline: 2px solid #aaa; outline-offset: 4px; }
	.preview { overflow: hidden; }
	.card-body { padding: 20px; }
	h2 { font-size: 25px; font-weight: 600; letter-spacing: -0.6px; margin: 0 0 8px; color: #eae7e0; }
	p { font-size: 13px; color: #999; margin: 0; line-height: 1.5; }
	.card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #242424; padding-top: 16px; margin-top: 22px; font-size: 11px; color: #999; }
	strong { margin-left: 5px; font-weight: 500; color: #ccc; font-variant-numeric: tabular-nums; }
	.play { color: #ccc; text-transform: uppercase; letter-spacing: 1px; }
	.arcade-toolbar { display: flex; justify-content: flex-end; margin-top: 22px; }
	.scores-toggle { flex: none; display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 10px 14px; border: 1px solid #b28c48; border-radius: 3px; background: #e6b65b0a; color: #edc77f; font: bold 11px 'Courier New', monospace; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
	.scores-toggle:hover, .scores-toggle[aria-pressed="true"] { background: #e6b65b1a; }
	.scores-toggle > span:first-child { font-size: 22px; }
	button:focus-visible { outline: 2px solid #edc77f; outline-offset: 4px; }
	.card-rotor { display: grid; height: 100%; transform-style: preserve-3d; transition: transform .65s cubic-bezier(.2,.65,.25,1); }
	.card-front, .card-back { grid-area: 1 / 1; min-width: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
	.games[data-scores="true"] .card-rotor { transform: rotateY(180deg); }
	.card-back { display: flex; flex-direction: column; transform: rotateY(180deg); padding: 24px; border: 1px solid #b28c4866; border-radius: 6px; background: repeating-linear-gradient(0deg, #ffffff03 0 1px, transparent 1px 4px), #10130f; box-shadow: inset 0 0 38px #0009; }
	.card-back h2 { margin: 10px 0 24px; color: #f4c674; font: bold 24px/1.2 'Courier New', monospace; text-transform: uppercase; text-shadow: 0 0 16px #e9ae4540; }
	.cabinet-kicker { color: #ac9773; font: 10px 'Courier New', monospace; letter-spacing: 2px; text-transform: uppercase; }
	.cabinet-rule { display: flex; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid #b28c4844; color: #938366; font: 10px 'Courier New', monospace; text-transform: uppercase; }
	.cabinet-status { margin-top: 20px; color: #c5bea8; font: 12px/1.6 'Courier New', monospace; }
	.cabinet-status:empty { display: none; }
	.cabinet-actions { display: flex; justify-content: space-between; gap: 8px; align-items: center; margin-top: auto; padding-top: 16px; border-top: 1px solid #b28c4844; }
	.cabinet-actions a, .cabinet-actions button { display: flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: none; color: #f4c674; font: 11px 'Courier New', monospace; text-decoration: none; text-transform: uppercase; cursor: pointer; }
	@media (prefers-reduced-motion: reduce) { .card-rotor { transition: none; } }
	@media (max-width: 600px) { .card-back { padding: 20px; } }
	@media (max-width: 600px) {
		main { padding: max(14px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); }
		header { margin-bottom: 20px; padding-bottom: 16px; }
		h1 { font-size: 36px; margin-top: 8px; }
		.games { gap: 18px; }
		.card-body { padding: 16px; }
		h2 { font-size: 22px; }
		.card-footer { padding-top: 12px; margin-top: 14px; }
	}
	@media (max-width: 480px) { .games { grid-template-columns: 1fr; } }
</style>
