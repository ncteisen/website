---
import UmamiAnalytics from '../../components/UmamiAnalytics.astro';
import IconLinks from '../../components/IconLinks.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import SocialPreview from '../../components/SocialPreview.astro';
import { projects } from '../../data/projects';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<IconLinks />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Projects | Noah Eisen</title>
		<SocialPreview
			title="Noah Eisen - Projects"
			description="A catalog of my side projects, games, and web experiments."
			path="/projects/"
		/>
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet" />
		<UmamiAnalytics />
		<style>
			*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
			html, body { min-height: 100%; }

			body {
				background: #0a0a0a;
				font-family: 'DM Sans', sans-serif;
				color: #e2dfd8;
				-webkit-font-smoothing: antialiased;
			}

			.wrap {
				max-width: 920px;
				margin: 0 auto;
				padding: 52px 44px 80px;
			}

			.back-link {
				font-size: 11px;
				color: #666;
				text-decoration: none;
				letter-spacing: 1px;
				text-transform: uppercase;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 28px;
				transition: color 0.15s;
			}

			.back-link:hover { color: #999; }

			.page-title {
				font-size: 48px;
				font-weight: 700;
				letter-spacing: -1.5px;
				margin: 0 0 10px;
				color: #eae7e0;
				line-height: 1;
			}

			.page-desc {
				font-size: 14px;
				color: #777;
				margin: 0;
				line-height: 1.7;
				max-width: 540px;
			}

			.projects-list {
				list-style: none;
				margin-top: 36px;
				border-top: 1px solid #222;
			}

			.projects-list li {
				border-bottom: 1px solid #1a1a1a;
			}

			.project-entry {
				display: grid;
				grid-template-columns: 88px 166px minmax(0, 1fr) 16px;
				gap: 24px;
				align-items: center;
				padding: 16px 0;
				color: inherit;
				text-decoration: none;
			}

			.project-visual {
				height: 56px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.project-title {
				font-size: 17px;
				font-weight: 500;
				letter-spacing: -0.2px;
				line-height: 1.5;
				color: #d8d5ce;
				transition: color 0.15s;
			}

			.project-desc {
				font-size: 13px;
				color: #888;
				line-height: 1.65;
			}

			.project-arrow {
				font-size: 16px;
				line-height: 1;
				color: #666;
				text-align: right;
				transition: color 0.15s;
			}

			.project-entry:hover .project-title,
			.project-entry:focus-visible .project-title { color: #fff; }

			.project-entry:hover .project-arrow,
			.project-entry:focus-visible .project-arrow { color: #d8d5ce; }

			.project-entry:focus-visible,
			.back-link:focus-visible {
				outline: 1px solid #888;
				outline-offset: 6px;
				border-radius: 2px;
			}

			@media (max-width: 768px) {
				.wrap { padding: 36px 24px 60px; }
				.page-title { font-size: 36px; }
				.projects-list { margin-top: 28px; }

				.project-entry {
					grid-template-columns: minmax(0, 1fr) 68px;
					gap: 5px 20px;
					padding: 20px 0;
				}

				.project-visual {
					grid-column: 2;
					grid-row: 1 / span 2;
					height: 48px;
				}

				.project-title { grid-column: 1; grid-row: 1; }

				.project-desc {
					grid-column: 1;
					grid-row: 2;
				}

				.project-arrow { display: none; }
			}

			@media (prefers-reduced-motion: reduce) {
				.project-title, .project-arrow, .back-link { transition: none; }
			}
		</style>
	</head>
	<body>
		<main class="wrap">
			<div>
				<a href="/" class="back-link" data-umami-event="link_click" data-umami-event-area="navigation" data-umami-event-label="home">&larr; Back to Noah Eisen</a>
				<h1 class="page-title">Projects</h1>
				<p class="page-desc">A catalog of my side projects, games, and web experiments.</p>
			</div>

			<ul class="projects-list" aria-label="Projects">
				{projects.map((project) => (
					<li>
						<a
							href={project.href}
							class="project-entry"
							style={`--project-accent: ${project.accent}`}
							target={project.external ? '_blank' : undefined}
							rel={project.external ? 'noopener noreferrer' : undefined}
							data-umami-event="link_click"
							data-umami-event-area="projects"
							data-umami-event-label={project.label}
						>
							<div class="project-visual" aria-hidden="true">
								<ProjectVisual label={project.label} subtle />
							</div>
							<h2 class="project-title">{project.title}</h2>
							<p class="project-desc">{project.description}</p>
							<span class="project-arrow" aria-hidden="true">{project.external ? '↗' : '→'}</span>
						</a>
					</li>
				))}
			</ul>
		</main>
	</body>
</html>
