---
import ArcadeGame from '../../layouts/ArcadeGame.astro';
---
<ArcadeGame gameId="flappy-sarah">
	<script>
		import { FlappySarah } from '../../games/flappy-sarah/FlappySarah';
		const root = document.querySelector<HTMLElement>('[data-game="flappy-sarah"]');
		if (root) {
			const game = new FlappySarah(root);
			void game.init();
			document.addEventListener('astro:before-swap', () => game.cleanup(), { once: true });
			if (import.meta.hot) import.meta.hot.dispose(() => game.cleanup());
			if (import.meta.env.DEV && new URLSearchParams(location.search).has('playtest')) {
				void import('../../../scripts/arcade/browser-harness').then(({ installPlaytest }) => installPlaytest(game));
			}
		}
	</script>
</ArcadeGame>
