---
import ArcadeGame from '../../layouts/ArcadeGame.astro';
import { games } from '../../games/arcade/catalog';
import type { CollectionId } from '../../games/arcade/collection/core';
export function getStaticPaths() {
	return games.filter(game => game.id !== 'sarah-jumps' && game.id !== 'flappy-sarah').map(game => ({ params: { arcadeGame: game.id }, props: { gameId: game.id } }));
}
interface Props { gameId: CollectionId }
---
<ArcadeGame gameId={Astro.props.gameId}>
	<script>
		import { Game } from '../../games/arcade/collection/Game';
		import type { CollectionId } from '../../games/arcade/collection/core';
		const root = document.querySelector<HTMLElement>('[data-collection]');
		if (root) {
			const game = new Game(root, root.dataset.game as CollectionId);
			void game.init();
			document.addEventListener('astro:before-swap', () => game.cleanup(), { once: true });
			if (import.meta.hot) import.meta.hot.dispose(() => game.cleanup());
			if (import.meta.env.DEV && new URLSearchParams(location.search).has('playtest')) {
				void import('../../../scripts/arcade/collection-browser').then(({ installPlaytest }) => installPlaytest(game));
			}
		}
	</script>
</ArcadeGame>
