---
import IconLinks from '../../components/IconLinks.astro';
import SocialPreview from '../../components/SocialPreview.astro';
import UmamiAnalytics from '../../components/UmamiAnalytics.astro';
import { rooms } from '../../features/apartment/layout';
import '../../features/apartment/style.css';
const photos = [
	['dining','Dining room'],['entry','Entry & hallway'],['kitchen','Kitchen'],['bath','Bathroom'],
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#bdc7bf" />
		<title>The apartment | Noah Eisen</title>
		<IconLinks />
		<SocialPreview title="The apartment — a study of home" description="A photo-textured model of home. Orbit the cutaway, unfold the floor plan, or walk inside." path="/projects/apartment/" />
		<UmamiAnalytics />
	</head>
	<body>
		<a class="skip-link" href="#viewer">Skip to apartment model</a>
		<main class="apartment" aria-label="Interactive apartment" id="apartment">
			<header class="page-header">
				<div><a class="back" href="/projects/">← Noah Eisen / Projects</a><h1>The apartment</h1><p>A study of home · 93 photographs</p></div>
				<nav class="tools" aria-label="Project tools"><button type="button" id="show-photos">Reference photos</button><button type="button" id="show-about" aria-label="About this model">About</button><button type="button" id="fullscreen">Expand ↗</button></nav>
			</header>
			<div class="viewport-wrap">
				<div id="viewer" tabindex="0" role="region" aria-label="3D apartment. In walkthrough, use W A S D or arrow keys to move and drag to look." aria-describedby="view-help">
					<div id="loading" role="status"><span class="loading-house" aria-hidden="true">⌂</span>Opening the apartment…</div>
					<div id="room-labels" aria-label="Room locations" hidden></div>
					<div id="fallback" hidden><h2>The 3D view couldn’t start</h2><p>Try a browser with WebGL enabled. Here’s the approximate layout.</p><svg viewBox="-21 -3 30 56" role="img" aria-label="Floor plan: living and dining in front, hallway past the kitchen, WC and bath, office and bedroom in back.">{rooms.map(room => <g><rect x={room.bounds[0]} y={room.bounds[1]} width={room.bounds[2]-room.bounds[0]} height={room.bounds[3]-room.bounds[1]} /><text x={(room.bounds[0]+room.bounds[2])/2} y={(room.bounds[1]+room.bounds[3])/2}>{room.name}</text></g>)}</svg></div>
				</div>
				<div class="walk-controls" id="walk-controls" hidden role="group" aria-label="Walk controls"><button type="button" data-move="forward" aria-label="Walk forward">↑</button><div><button type="button" data-move="left" aria-label="Step left">←</button><button type="button" data-move="back" aria-label="Walk backward">↓</button><button type="button" data-move="right" aria-label="Step right">→</button></div></div>
			</div>
			<aside class="view-info"><span id="current-room" aria-live="polite">The whole apartment</span><p id="room-detail" aria-live="polite">Choose a room to look closer.</p></aside>
			<div class="dock">
				<div class="dock-top">
					<div class="modes" role="group" aria-label="View mode"><button type="button" data-mode="dollhouse" aria-pressed="true">Dollhouse</button><button type="button" data-mode="plan" aria-pressed="false">Floor plan</button><button type="button" data-mode="walk" aria-pressed="false">Walk through</button></div>
					<div class="lights" role="group" aria-label="Lighting"><button type="button" data-light="day" aria-pressed="true">Daylight</button><button type="button" data-light="evening" aria-pressed="false">Lamps</button></div>
					<button type="button" id="reset-view" aria-label="Reset view">Reset ↺</button>
					<details class="settings-menu"><summary>Settings</summary><div class="settings"><label class="wall-setting">Front walls <input id="wall-height" type="range" min="0.4" max="8.75" step="0.05" value="0.65" /><output id="wall-value" for="wall-height">0.7 ft</output></label><div class="toggles"><label><input id="show-furniture" type="checkbox" checked /> Furniture</label><label><input id="show-labels" type="checkbox" /> Room names</label></div><button type="button" id="download-model">Download 3D model ↓</button></div></details>
				</div>
				<nav class="room-buttons" aria-label="Rooms">{rooms.map((room,index) => <button type="button" data-room={room.id} aria-pressed="false"><span class="room-number">{String(index+1).padStart(2,'0')}</span>{room.name}</button>)}</nav>
			</div>
			<p id="view-help">Drag to orbit · scroll to zoom</p>
			<dialog id="photo-dialog" aria-label="Reference photos"><div class="dialog-header"><label for="photo-select">From the camera roll</label><button type="button" data-close="photo-dialog" aria-label="Close reference photos">Close ×</button></div><select id="photo-select" aria-label="Choose reference photo">{photos.map(([id,name])=><option value={id}>{name}</option>)}</select><img id="reference-photo" src="/images/apartment/reference-dining.webp" alt="Dining room reference photograph" loading="lazy" /><p>Selected photographs used to model the rooms and materials.</p></dialog>
			<dialog id="about-dialog" aria-labelledby="about-title"><div class="dialog-header"><h2 id="about-title">A familiar place, in 3D.</h2><button type="button" data-close="about-dialog" aria-label="Close model information">Close ×</button></div><p>Built from 85 photographs, eight follow-ups, and a few measurements. The fireplace, artwork, bookcases, textiles and wood use textures extracted from those photographs.</p><p>The living room is 11.5 × 18 ft, the hall is 21 ft long, the bay recess is 19 in, and the ceiling is about 8.75 ft. Other dimensions are estimated. This is a modeled, photo-textured apartment; it is not a photogrammetric scan.</p><p>Orbit to reveal the far walls. Choose a room to look closer, or walk through using WASD, arrow keys, and drag-to-look. On a phone, use the on-screen arrows. Download the GLB in Settings to open it in a 3D editor.</p><p class="credit">Viewing experience inspired by <a href="https://page-st-apt.vercel.app/" target="_blank" rel="noopener noreferrer">Apartment Study ↗</a>.</p></dialog>
		</main>
		<noscript><p class="no-script">JavaScript is needed for the interactive model.</p></noscript>
		<script>import '../../features/apartment/client';</script>
	</body>
</html>
