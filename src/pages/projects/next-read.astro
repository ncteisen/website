---
import IconLinks from '../../components/IconLinks.astro';
import SocialPreview from '../../components/SocialPreview.astro';
import '../../features/next-read/style.css';
const api = import.meta.env.PUBLIC_NEXT_READ_API_URL ?? 'https://next-read.astro-test.workers.dev';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f5f0" />
		<title>Next Read — book recommendations</title>
		<IconLinks />
		<SocialPreview title="Next Read" description="Tell us what you’re in the mood for. Three words or phrases, three book recommendations." path="/projects/next-read" image="/images/next-read/social.png" />
	</head>
	<body data-api={api}>
		<a class="skip-link" href="#mood-form">Skip to book recommendations</a>
		<header class="site-header">
			<a href="/projects/next-read" class="wordmark" aria-label="Next Read home">Next Read</a>
			<button id="open-saved" class="text-button">Saved books <span id="saved-count">0</span></button>
		</header>
		<main>
			<section class="intro" aria-labelledby="intro-title">
				<h1 id="intro-title">What would you like to read?</h1>
				<p>Three words or phrases will do.<br />A place, a preoccupation, a book you loved.</p>
			</section>
			<form id="mood-form">
				<div class="phrase-inputs">
					<label class="phrase-field"><span>First</span><input name="phrase1" id="phrase-1" maxlength="70" placeholder="the sea" autocomplete="off" required /></label>
					<label class="phrase-field"><span>Second</span><input name="phrase2" id="phrase-2" maxlength="70" placeholder="unreliable narrators" autocomplete="off" required /></label>
					<label class="phrase-field"><span>Third</span><input name="phrase3" id="phrase-3" maxlength="70" placeholder="something short" autocomplete="off" required /></label>
				</div>
				<div class="form-actions"><button class="primary-button" id="find-books" type="submit">Find books</button><button type="button" id="shuffle" class="text-button">Choose for me</button></div>
			</form>
			<p id="request-status" class="request-status" role="status" aria-live="polite"></p>
			<div id="error-box" class="error-box" role="alert" hidden><p id="error-message"></p><button id="retry" class="text-button">Try again</button></div>
			<section id="loading" class="loading" aria-label="Finding books" hidden><p>Choosing books…</p></section>
			<section id="results" class="results" aria-labelledby="shelf-title" hidden>
				<div id="shared-banner" class="shared-banner" hidden><p>Someone sent you these books.</p><button id="remix" class="text-button">Find my own suggestions</button></div>
				<div class="results-heading"><div><h2 id="shelf-title" tabindex="-1">Three suggestions</h2><p id="shelf-phrases" class="shelf-phrases"></p></div><button id="share-shelf" class="text-button">Share this list</button></div>
				<div id="book-grid" class="book-list"></div>
				<div class="results-bottom"><button id="another-round" class="text-button">Show me three others</button></div>
			</section>
		</main>
		<footer><a href="/projects">Noah Eisen</a><div><button id="about" class="text-button">About</button><button id="reset-taste" class="text-button">Clear preferences <span id="taste-count"></span></button></div></footer>
		<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
		<dialog id="saved-dialog" aria-labelledby="saved-title"><div class="dialog-heading"><h2 id="saved-title">Saved books</h2><button class="close-dialog text-button" aria-label="Close saved books">Close</button></div><p class="dialog-note">Stored in this browser.</p><div id="saved-list"></div></dialog>
		<dialog id="share-dialog" aria-labelledby="share-title"><div class="dialog-heading"><h2 id="share-title">Share these books</h2><button class="close-dialog text-button" aria-label="Close sharing">Close</button></div><div id="share-preview" class="share-preview"><p id="share-phrases"></p><div id="share-titles"></div></div><div class="share-actions"><button id="copy-link" class="primary-button">Copy link</button><button id="download-card" class="text-button">Save reading list</button><button id="native-share" class="text-button" hidden>Send</button></div><p class="dialog-note">Includes your three phrases and these recommendations. Your preferences and saved books aren’t shared.</p><label id="manual-link-label" hidden>Copy this link<input id="manual-link" readonly /></label></dialog>
		<dialog id="about-dialog" aria-labelledby="about-title"><div class="dialog-heading"><h2 id="about-title">About Next Read</h2><button class="close-dialog text-button" aria-label="Close about">Close</button></div><p>Next Read uses AI to choose from a fixed selection of fiction, nonfiction, poetry and graphic books. It considers your three phrases and any books you’ve liked or disliked. “Not interested” excludes that book without making assumptions about your taste.</p><p>Your phrases and reactions are sent to OpenAI. Saved books and preferences stay in this browser. The server keeps short-lived usage counters, but no reading profiles.</p><p>The notes are AI-written interpretations. Links lead to Open Library, where you can check details and look for an edition.</p></dialog>
		<noscript><p class="error-box">Please enable JavaScript to get recommendations.</p></noscript>
		<script>import '../../features/next-read/client';</script>
	</body>
</html>
