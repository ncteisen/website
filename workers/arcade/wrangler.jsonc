{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sarah-arcade-scores",
	"main": "index.ts",
	"compatibility_date": "2026-10-14",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "https://noaheisen.com,https://www.noaheisen.com"
	},
	"d1_databases": [{
		"binding": "DB",
		"database_name": "sarah-arcade-scores",
		"database_id": "d4eb6c5a-e828-4e06-8131-49df4c79f97d",
		"migrations_dir": "migrations"
	}],
	"ratelimits": [
		{ "name": "REQUEST_LIMIT", "namespace_id": "104151001", "simple": { "limit": 300, "period": 60 } },
		{ "name": "WRITE_LIMIT", "namespace_id": "104151002", "simple": { "limit": 60, "period": 60 } }
	]
}
